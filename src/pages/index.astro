const featuredProjects = projects.filter(
  (project) => project.featured,
);

const engineeringProjects = projects.filter(
  (project) =>
    !project.featured &&
    project.category === "UNREAL ENGINE PLUGIN",
);

const gameJamProjects = projects.filter(
  (project) => project.category === "GAME JAM",
);

const showcaseVideos = [
  {
    number: "01",
    category: "Animations",
    title: "Procedural Monster Animation",
    description:
      "Procedural animation developed in Unreal Engine with Control Rig",
    technologies: ["Unreal Enigne", "Control Rig"],
    video: "/videos/MonsterPreview.mp4",
    poster: "/images/MonsterPreview.PNG",
    link: "",
    linkLabel: ""
  },
  {
    number: "",
    category: "Gameplay Programming",
    title: "Combat Enemy System",
    description:
      "Enemy AI system demonstrating combat behavior, " +
      "perception and tactical decision-making.",
    technologies: ["C++", "Unreal Engine", "StateTree", "Combat AI"],
    video: "/videos/EnemyRanged.mp4",
    poster: "/images/EnemyPreview.PNG",
    link: "https://github.com/AnDreY-MA/CombatEnemySystem",
    linkLabel: "View source code↗"
  }
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Gameplay Engineer specializing in Unreal Engine gameplay systems, AI, C++ and Vulkan rendering."
    />
    <meta name="theme-color" content="#101116" />
    <title>Andrey Mamontov — Game Programmer</title>
  </head>

  <body>
    <header class="header">
      <div class="container header__inner">
        <!-- <a class="brand" href="/" aria-label="Home">
          <span class="brand__mark">AM</span>
          <span class="brand__name">ANDREY MAMONTOV</span>
        </a> -->

        <nav class="nav" aria-label="Main navigation">
          <a href="#work">Projects</a>
          <a href="#contact">Contact</a>
        </nav>

        <a
          class="header__github"
          href="https://github.com/AnDreY-MA"
          target="_blank"
          rel="noreferrer"
        >
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <main>
      <section class="hero container">
        <div class="hero__content">
          <p class="eyebrow">
            <span class="status-dot"></span>
            C++ GAME PROGRAMMER
          </p>

          <h1>
            I'm Andrey Mamontov<br />
          </h1>

          <p class="hero__description">
            I'm C++ programmer on Unreal Engine with 3 year of experience. 
			Specialized in creating and optimizing gameplay systems, including complex combat mechanics, AI, and UI components. 
			Developed and extended plugins, as well as proficient in Unreal Engine Gameplay Ability System and CommonUI.
          </p>

          <div class="hero__actions">
            <a class="button button--primary" href="#work">
              Explore projects <span aria-hidden="true">↗</span>
            </a>

            <a
              class="button button--secondary"
              href="https://github.com/AnDreY-MA"
              target="_blank"
              rel="noreferrer"
            >
              View GitHub
            </a>
          </div>

          <div class="hero__skills" aria-label="Technical skills">
            {skills.map((skill) => (
              <span class="skill-tag">{skill}</span>
            ))}
          </div>
        </div>

        
      </section>
      
	<section class="work container" id="work">
	<div class="section-heading">
		<h2>Games and technology.</h2>
		<p class="section-description">
		Gameplay systems, independent games, and engine development.
		</p>
	</div>

	<div class="project-grid project-grid--featured">
		{featuredProjects.map((project) => (
		<article class="project-card">
			<a
			class="project-card__media"
			href={project.links[0].url}
			target="_blank"
			rel="noreferrer"
			aria-label={`Open ${project.title}`}
			>
			{project.image ? (
				<img
				src={project.image}
				alt={project.imageAlt}
				loading="lazy"
				/>
			) : (
				<div class="project-card__placeholder">
				<span>PROJECT / ENGINEERING</span>
				<span class="project-card__placeholder-title">
					{project.title}
				</span>
				</div>
			)}
			<span class="project-card__open" aria-hidden="true">↗</span>
			</a>

			<div class="project-card__body">
			<p class="project-card__category">{project.category}</p>
			<h3>{project.title}</h3>
			<p class="project-card__description">
				{project.description}
			</p>

			<div class="project-card__tags">
				{project.technologies.map((technology) => (
				<span class="skill-tag">{technology}</span>
				))}
			</div>

			<div class="project-card__links">
				{project.links.map((link) => (
				<a href={link.url} target="_blank" rel="noreferrer">
					{link.label} <span aria-hidden="true">↗</span>
				</a>
				))}
			</div>
			</div>
		</article>
		))}
	</div>

  <section class="video-showcase" id="showcase">
  <div class="video-showcase__inner">
    <div class="video-showcase__header">
      <span class="section-label"></span>
      <h2>Showcase</h2>

    </div>

    <div class="video-showcase__list">
      {showcaseVideos.map((item) => (
        <article class="showcase-item">
          <div class="showcase-item__heading">
            <h3>{item.title}</h3>

            <p>{item.description}</p>
          </div>

          <div class="showcase-item__media">
            <video
              controls
              playsinline
              preload="none"
              poster={item.poster}
            >
              <source src={item.video} type="video/mp4" />
            </video>
          </div>

          <div class="showcase-item__footer">
            <div class="showcase-item__technologies">
              {item.technologies.map((tech) => (
                <span>{tech}</span>
              ))}
            </div>

            <a
              href={item.link}
              target="_blank"
              rel="noreferrer"
            >
              {item.linkLabel} 
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

	<div class="section-heading section-heading--subsection">
		<p class="eyebrow">UNREAL ENGINE / TOOLS</p>
		<h3>Plugins and systems.</h3>
	</div>

	<div class="project-grid project-grid--compact">
		{engineeringProjects.map((project) => (
		<article class="project-card project-card--compact">
			<div class="project-card__body">
			<p class="project-card__category">{project.category}</p>
			<h3>{project.title}</h3>
			<p class="project-card__description">
				{project.description}
			</p>

			<div class="project-card__tags">
				{project.technologies.map((technology) => (
				<span class="skill-tag">{technology}</span>
				))}
			</div>

			<div class="project-card__links">
				{project.links.map((link) => (
				<a href={link.url} target="_blank" rel="noreferrer">
					{link.label} <span aria-hidden="true">↗</span>
				</a>
				))}
			</div>
			</div>
		</article>
		))}
	</div>

	<div class="section-heading section-heading--subsection">
		<p class="eyebrow">GAME JAMS</p>
		<h3>Games created on game jams</h3>
	</div>

	<div class="project-grid project-grid--archive">
		{gameJamProjects.map((project) => (
		<article class="project-card project-card--archive">
			<a
			class="project-card__media"
			href={project.links[0].url}
			target="_blank"
			rel="noreferrer"
			>
			{project.image && (
				<img
				src={project.image}
				alt={project.imageAlt}
				loading="lazy"
				/>
			)}
			</a>

			<div class="project-card__body">
			<p class="project-card__category">{project.category}</p>
			<h3>{project.title}</h3>
			<p class="project-card__description">
				{project.description}
			</p>
			<div class="project-card__links">
				{project.links.map((link) => (
				<a href={link.url} target="_blank" rel="noreferrer">
					{link.label} <span aria-hidden="true">↗</span>
				</a>
				))}
			</div>
			</div>
		</article>
		))}
	</div>
	</section>


      <footer class="contact" id="contact">
  <div class="contact__inner">
    <h2 class="contact__title">My contacts</h2>

    <p class="contact__description">
      Have a project in mind or an interesting opportunity?
    </p>

    <div class="contact__links">
  <a
    class="contact__link"
    href="mailto:andreymamontov9@gmail.com"
  >
    andreymamontov9@gmail.com
    <span aria-hidden="true">↗</span>
  </a>

  <a
    class="contact__link"
    href="https://discord.com/users/715170014042390539"
    target="_blank"
    rel="noreferrer"
  >
    Discord
    <span aria-hidden="true">↗</span>
  </a>
</div>

    <div class="contact__footer">
      <span>Andrey Mamontov. Yes, it's site building with AI and Astro © 2026</span>
    </div>
  </div>
</footer>
    </main>
  </body>
</html>
